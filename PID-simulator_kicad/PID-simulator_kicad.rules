
(rules PCB PID-simulator_kicad.dsn
  (snap_angle 
    fortyfive_degree
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 200.0 (type "kicad_default"))
    (clearance 200.0 (type Power,Default))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-1]_1270:635_um"
    (shape
      (circle F.Cu 1270.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 1270.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_1270:635_um" "Via[0-1]_1270:635_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via 
    "Via[0-1]_1270:635_um-kicad_default" "Via[0-1]_1270:635_um" "kicad_default"
  )
  (via 
    "Via[0-1]_600:300_um-Power,Default" "Via[0-1]_600:300_um" Power,Default
  )
  (via 
    "Via[0-1]_1270:635_um-Power,Default" "Via[0-1]_1270:635_um" Power,Default
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (via_rule
    Power,Default "Via[0-1]_1270:635_um-Power,Default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "unconnected-(A1-PadA5)" "/D3 - IN2" "unconnected-(A1-PadA4)" "unconnected-(A1-3.3V-Pad3V3)" "/D2 - IN1" "unconnected-(A1-PadA2)" +5V "/D4 - C1"
    "unconnected-(A1-D1{slash}TX-PadD1)" "/D5 - C2" "unconnected-(A1-IOREF-PadIORF)" "unconnected-(A1-PadA1)" "unconnected-(A1-RESET-PadRST1)" "unconnected-(A1-D0{slash}RX-PadD0)" "unconnected-(A1-PadAREF)" "unconnected-(A1-PadA0)"
    "unconnected-(SW1-SW-Pad3)" "unconnected-(SW2-SW-Pad3)" "unconnected-(SW3-SW-Pad3)" "unconnected-(SW4-SW-Pad3)" "unconnected-(U1-IN4-Pad6)" "unconnected-(U1-MotorB-1-Pad9)" "unconnected-(U1-IN3-Pad5)" "unconnected-(U1-MotorB-2-Pad10)"
    /D13 /D9 /D10 /D7 /D11 /D8 /D12 /D6
    /SCL /SDA
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class Power,Default
    GND +6V "/MotorA-1" "/MotorA-2"
    (clearance_class Power,Default)
    (via_rule Power,Default)
    (rule
      (width 635.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)